# Server-only Supabase credentials. Do not copy either key into Expo/client code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# This account is provisioned once at server startup and receives the admin role.
ADMIN_EMAIL=support@your-domain.example
ADMIN_PASSWORD=

# Browser origin(s) only, comma-separated. Native requests have no Origin header.
ALLOWED_ORIGINS=https://finflowadvisors.com
